# Copy to .env and fill in. Never commit .env.

# ---- API --------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Bearer token accepted by the API for the demo owner account (change it).
DEMO_API_TOKEN=dev-demo-token-change-me

# ---- Data stores --------------------------------------------------------------
# Local (scripts/dev_db.py, embedded Postgres + pgvector on port 5433):
DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5433/revenue_recovery
# Docker compose overrides this to point at the postgres service.
# Optional. Without it an in-process cache is used.
REDIS_URL=

# ---- LLM (Groq) ---------------------------------------------------------------
GROQ_API_KEY=
# Any Groq chat model ID. Structured outputs with strict JSON schema currently work with
# openai/gpt-oss-120b and openai/gpt-oss-20b. Check https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# json_schema (constrained decoding, supported models only) or json_object (all models)
GROQ_STRUCTURED_MODE=json_schema
# Reasoning models only (gpt-oss): low | medium | high. Leave empty for non-reasoning models.
GROQ_REASONING_EFFORT=low
# SDK retries on 429/5xx (honours Groq's retry-after). Free tier is 8k tokens/min, so 4 is safer there.
LLM_MAX_RETRIES=2
# Optional cost-estimate override, USD per 1M tokens
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=

# ---- Observability (Langfuse) --------------------------------------------------
# Optional. Without keys, tracing is disabled and the app works normally.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Slack (optional) ------------------------------------------------------------
# Incoming webhook for the sales channel: api.slack.com/apps -> your app -> Incoming Webhooks.
# Alerts when the agent drafts an email that needs approval, and when someone approves/rejects.
SLACK_WEBHOOK_URL=
# Where links in Slack messages point (the web app).
APP_PUBLIC_URL=http://localhost:3100

# ---- Frontend -----------------------------------------------------------------------
# Next.js reads apps/web/.env.local (not this file). Put these two lines there (`make setup` does it).
# Server-side only: the route-handler proxy attaches the token; it never reaches the browser.
# API_BASE_URL=http://127.0.0.1:8000
# API_TOKEN=dev-demo-token-change-me
# Optional private-demo gate (set on Vercel): visitors must enter this code first.
# ACCESS_CODE=
# NEXT_PUBLIC_CONTACT_URL=https://www.linkedin.com/in/<you>
